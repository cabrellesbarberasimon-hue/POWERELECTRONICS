{
  "expo": {
    "name": "SENSE",
    "slug": "sense-power-electronics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.powerelectronics.sense",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SENSE uses Face ID to sign you in securely.",
        "NSCameraUsageDescription": "SENSE uses the camera to scan equipment for Augmented Reality training and to record content."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E88C4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.powerelectronics.sense",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E88C4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SENSE uses the camera to scan equipment for Augmented Reality training and to record content.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SENSE uses Face ID to sign you in securely."
        }
      ]
    ],
    "scheme": "sense",
    "experiments": {
      "typedRoutes": true
    }
  }
}
